{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // jest-expo turns these into Jest's moduleNameMapper, which takes the
    // first match — so the narrower "@/assets/*" has to come first.
    "paths": {
      "@/assets/*": ["./assets/*"],
      "@/*": ["./src/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
